# Version control
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets — NEVER bake into the image
.env
.env.*
!.env.example

# Dev/test artifacts
tests/
scripts/test_*.py
*.log
logs/

# Local storage (uploaded files, encrypted docs)
storage/uploads/
storage/encrypted/

# Frontend (separate container)
frontend/

# IDE / OS
.vscode/
.idea/
*.swp
*.DS_Store
Thumbs.db

# Docs
*.md
!README.md

# Alembic output file (not needed at runtime)
alembic_out.txt
