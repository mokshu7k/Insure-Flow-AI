# =============================================================================
# .env — TRUE SECRETS AND ENVIRONMENT-SPECIFIC VALUES ONLY
#
# Rule of thumb:
#   .env         → secrets, credentials, per-environment overrides
#   config.py    → tuneable defaults (thresholds, timeouts, feature flags)
#   code         → constants that never change (ALGORITHM, APP_NAME, etc.)
# =============================================================================

# Secrets — generate new values for every environment
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
QR_SECRET_KEY=CHANGE_ME

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME

# Database — asyncpg format (ssl=require for Neon)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# GCP credentials (TTS + STT)
GCP_API_KEY=CHANGE_ME

# Environment-specific behaviour
DEBUG=False
COOKIE_SECURE=True
ALLOWED_ORIGINS=["https://yourapp.com"]
